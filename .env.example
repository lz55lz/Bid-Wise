# LangSmith 默认关闭。若企业环境明确允许外发 Trace 再启用；
# 启用时建议至少隐藏输入/输出，避免招标正文、Evidence 或用户问题进入外部观测平台。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bid-wise-local
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
